{
  "name": "@progress/kendo-angular-listbox",
  "version": "21.1.0",
  "description": "Kendo UI for Angular ListBox",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "Progress",
  "homepage": "https://www.telerik.com/kendo-angular-ui/components/",
  "bugs": {
    "url": "https://github.com/telerik/kendo-angular"
  },
  "keywords": [
    "Angular",
    "Kendo UI",
    "ListBox",
    "Progress"
  ],
  "@progress": {
    "friendlyName": "ListBox",
    "migrations": {
      "options": {
        "parser": "tsx",
        "pattern": "*.{ts,html}"
      },
      "codemods": {
        "19": [
          {
            "description": "Migrate selectedIndex to selectedIndices for ListBox component.",
            "file": "codemods/v21/listbox-selectedindex.js",
            "prompt": "true"
          },
          {
            "description": "Migrate actionClick to action for ListBox component.",
            "file": "codemods/v21/listbox-actionclick.js",
            "prompt": "true"
          },
          {
            "description": "Migrate Toolbar interface name to ListBoxToolbarConfig.",
            "file": "codemods/v21/listbox-toolbar.js",
            "prompt": "true"
          }
        ]
      }
    },
    "package": {
      "productName": "Kendo UI for Angular",
      "productCode": "KENDOUIANGULAR",
      "publishDate": 1763639171,
      "licensingDocsUrl": "https://www.telerik.com/kendo-angular-ui/my-license/?utm_medium=product&utm_source=kendoangular&utm_campaign=kendo-ui-angular-purchase-license-keys-warning"
    }
  },
  "peerDependencies": {
    "@angular/animations": "18 - 21",
    "@angular/common": "18 - 21",
    "@angular/core": "18 - 21",
    "@angular/platform-browser": "18 - 21",
    "@progress/kendo-licensing": "^1.7.0",
    "@progress/kendo-angular-buttons": "21.1.0",
    "@progress/kendo-angular-common": "21.1.0",
    "@progress/kendo-angular-popup": "21.1.0",
    "rxjs": "^6.5.3 || ^7.0.0"
  },
  "dependencies": {
    "tslib": "^2.3.1",
    "@progress/kendo-angular-schematics": "21.1.0",
    "@progress/kendo-common": "^1.0.1",
    "node-html-parser": "^7.0.1"
  },
  "schematics": "./schematics/collection.json",
  "module": "fesm2022/progress-kendo-angular-listbox.mjs",
  "typings": "index.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./index.d.ts",
      "esm2022": "./esm2022/progress-kendo-angular-listbox.mjs",
      "esm": "./esm2022/progress-kendo-angular-listbox.mjs",
      "default": "./fesm2022/progress-kendo-angular-listbox.mjs"
    }
  },
  "sideEffects": false
}